<?xml version="1.0" encoding="UTF-8"?>
<document category="recipe" source="MS Codex 625" media="manuscript recipe book" date="1720">
    <meta>
        <codeEditor>Kylie</codeEditor>
    </meta>
    <title makes="Shrewsbury Cakes">Shrewsbury Cakes: Original Recipe.</title>

    <background>
        <origin>This recipe comes from <source>MS Codex 625</source>, a manuscript recipe book that
            belonged to a student in a <place ref="london" country="England" continent="Europe"
                >London</place> cooking school in the <time>early eighteenth century</time>. </origin>
        <info>The pastry school was owned by <person id="ek" who="Edward Kidder"
                role="Owner of pastry school">Edward Kidder</person>, who taught at a few locations
            in <place ref="#london">London</place> between around <timeSpan year="1720-1734">1720
                and 1734</timeSpan>. Blank books with printed title pages seem to have been used by
            students to write down recipes they learned. <person ref="#ek">Kidder</person> also
            published his recipes in the printed volume, <book
                title="Receipts for Pastry and Cookery" author="ek" publish="1720">Receipts for
                Pastry and Cookery</book>, in <time year="1720">1720</time>.</info>
    </background>

    <metadata codeEditor="#kylie" for="#origRecipe">
        <originalIngList>
            <ing ref="bttr" quant="1 lb" unit="pound" altQuant="4 sticks" altUnit="sticks">1 lb. (4
                sticks) butter</ing>
            <ing ref="sgr" quant="1 lb" unit="pound" prepare="double refined">1 lb. sugar</ing>
            <ing ref="mace" quant="a little" unit="guess">A little mace</ing>
            <ing ref="egg" quant="4 eggs" unit="egg">4 eggs</ing>
            <ing ref="flr" quant="0.5 lb" unit="pound">1/2 lb. flower</ing>
        </originalIngList>
        
        <originalToolList>
            <tool ref="hand" listItem="1">Hands</tool>
            <tool ref="sift" listItem="2">Sifter</tool>
            <tool ref="rollingPin" listItem="3">Rolling Pin</tool>
        </originalToolList>
    </metadata>

    <recipe id="origRecipe">
        <step num="1" from="#origRecipe">Take a pound of fresh <ing ref="#bttr">butter</ing> a pound
            of double refind <ing ref="#sgr">sugar</ing>
            <action use="#sift">sifted fine</action> a little <action>beaten</action>
            <ing ref="#mace">mace</ing> &amp; 4 <ing ref="#egg">eggs</ing>
            <action use="#hand">beat <mixture usedIngs="#bttr #sgr #mace #egg">them</mixture> all
                together with. your <tool use="#hand">hands</tool></action> till tis very leight
            &amp; looks curdling</step>
        <step num="2" from="#origRecipe">you <action>put thereto</action> a pound &amp; 1/2 of <ing
                ref="flr">flower</ing></step>
        <step num="3" from="#origRecipe"><action use="#rollingPin">roul them out</action> into little <cookie
                type="shrewsbury">cakes</cookie></step>
    </recipe>

    <modernRecipe>
        <intro>Our recipe <aside>(halved from the original)</aside></intro>

        <ingList>
            <ing id="bttr" quant="0.5 lb" altQuant="2 sticks" unit="pound" altUnit="sticks"
                prepare="softened" listItem="1">1/2 lb. (2 sticks) butter, softened</ing>
            <ing id="sgr" quant="0.5 lb" unit="pound" listItem="2">1/2 lb. sugar</ing>
            <ing id="mace" quant="0.25 tsp" unit="teaspoon" listItem="3">1/4 tsp. mace</ing>
            <ing id="cinn" quant="0.5 tsp" unit="teaspoon" listItem="4">1/2 tsp. cinnamon</ing>
            <ing id="egg" quant="2 eggs" unit="egg" listItem="5">2 eggs</ing>
            <ing id="flr" quant="0.75 lb" unit="pound" listItem="6">3/4 lb. flour</ing>
        </ingList>

        <metadata codeEditor="#kylie" for="#modernRecipe">
            <toolList>
                <tool ref="elecMixer" listItem="1">Electric Mixer</tool>
                <tool ref="sift" listItem="2">Sifter</tool>
                <tool ref="scoop" listItem="3">Scoop</tool>
                <tool ref="fridge" listItem="4">Fridge</tool>
                <tool ref="hand" listItem="5">Hand</tool>
                <tool ref="flatSurf" listItem="6">Flat Surface</tool>
                <tool ref="rollingPin" listItem="7">Rolling Pin</tool>
                <tool ref="cutter" listItem="8">Cutter</tool>
                <tool ref="oven" listItem="9">Oven</tool>
            </toolList>
        </metadata>

        <process>
            <p num="1">
                <step num="1">Using an <tool ref="#elecMixer">electric
                        mixer</tool>, <action ref="#elecMixer" combine="#bttr #sgr">cream
                        together</action> the <ing ref="#bttr">butter</ing> and <ing ref="#sgr"
                        >sugar</ing>. </step>
                <step num="2">Then <action>add</action> the <ing ref="#egg"
                        >eggs</ing> and <action use="#elecMixer" speed="medium">mix at medium
                        speed</action> until the <mixture usedIngs="#bttr #sgr #eggs"
                        >mixture</mixture> looks curdled. </step>
                <step num="3"><action ref="#sift">Sift together</action>
                    <mixture usedIngs="#mace #cinn #flr">dry ingredients</mixture> and <action
                        use="#elecMixer" speed="low speed">add at low speed</action> until just
                    combined. </step>
                <step num="4"><action use="#scoop #hand">Scoop and
                        roll</action> the <ing id="dgh">dough</ing> by <tool use="#hand">hand</tool>
                    into <ing ref="#dgh" measure="1-tbsp balls" unit="tablespoo">1-tbsp.
                    balls</ing>, then <action use="#hand">pat flat</action>.</step>
                <step num="5" optional="Replace with step 4">[You could also
                        <action use="#fridge">refrigerate</action> the <ing ref="#dgh">dough</ing>
                    until <ing ref="dgh">it’s</ing>
                    <texture>firm</texture> enough to <action use="#rollingPin">roll out</action> on
                    a <tool use="#flatSurf">flat surface</tool> and <action use="#cutter">cut
                        out</action> into <shape>rounds</shape>.]</step>
            </p>

            <p num="2">
                <step num="6"><action use="#oven">Bake</action> at <bakeTemp
                        temp="350F" tempAlt="177C">350F</bakeTemp> for <bakeTime minutes="15-18"
                        >15-18 minutes</bakeTime>
                    <aside>(ours were about <thickness measure="0.33″" unit="inch">1/3″
                            thick</thickness>, so <optional>you could <action use="#rollingPin"
                                >roll</action>
                            <ing ref="#dgh">them</ing> thinner and have a slightly shorter cooking
                            time)</optional>.</aside> They’re done once they turn the slightest bit
                    brown around the edges. <yield quant="24 cookies">This halved recipe yielded
                        about two dozen cookies.</yield></step>
            </p>
        </process>

        <results>
            <intro>The Results</intro>

            <p>If you like <cookie type="snickerdoodles">snickerdoodles</cookie>
                <aside>(and who doesn’t?)</aside>, you’d like these. <changeToOrig>We
                        <action>added</action> the <ing ref="#cinn">cinnamon</ing> because we like
                    it and couldn’t resist, and we thought it rounded out the <ing ref="#mace"
                        >mace</ing> nicely. </changeToOrig>
                <review>These are <flavor>mild</flavor>,<texture> fairly soft </texture><cookie
                        type="#shrewsbury">cookies</cookie> that are great with <drink type="tea"
                        >tea</drink>. We <action use="#rollingPin">rolled and patted</action> the
                        <ing ref="dgh">dough</ing> into individual <cookie type="#shrewsbury"
                        >cookies</cookie> because it was <texture>too soft and stick</texture> to
                        <action use="#rollingPin">roll out</action>, but a little bit more <ing
                        ref="#flr">flour</ing> and a <time>stint</time> in the <tool use="#fridge"
                        >fridge</tool> might make the <ing ref="#dgh">dough</ing> easier to work
                    with a <tool use="#rollingPin">rolling pin</tool>.</review></p>
        </results>
    </modernRecipe>
</document>
