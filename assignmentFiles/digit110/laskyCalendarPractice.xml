<TEI xmlns="http://www.tei-c.org/ns/1.0">
   <teiHeader>
      <fileDesc>
         <titleStmt>
            <title>Mary Behrend Calendar Sheets</title>
            <author>Mary Behrend</author>
            <editor xml:id="kal6436">Kylie Lasky</editor>
         </titleStmt>
         <publicationStmt>
            <p>Publication Information</p>
            <p>Not officially published</p>
         </publicationStmt>
         <sourceDesc>
            <msDesc>
               <msIdentifier>
                  <repository>The Behrend College Library</repository>
               </msIdentifier>
               <physDesc>
                  <handDesc>
                     <handNote xml:id="print" medium="print">Printed text in black ink</handNote> <!-- Noting the specific mediums used throughout the calendar sheets by creating an index to reference -->
                     <handNote xml:id="printFancy" medium="print">Printed text in grey ink with a
                        fanciful font</handNote>
                     <handNote xml:id="blackPen" medium="black pen">Mary Behrend writing with a
                        black ink pen</handNote>
                     <handNote xml:id="redPen" medium="red pen">Mary Behrend writing with a red ink
                        pen</handNote>
                     <handNote xml:id="multiMedia" medium="Multiple media">Denotes the use of
                        multiple medias used by Mary Behrend to create her illustrations</handNote>
                     <handNote xml:id="greenPen" medium="green pen">Mary Behrend writing with a
                        green ink pen</handNote>
                  </handDesc>
               </physDesc>
            </msDesc>
         </sourceDesc>
      </fileDesc>
   </teiHeader>
   <text>
      <body>
         <div type="sheet" n="1">
            <fw place="top-center" hand="#print"><emph rend="bold"><l>COPYRIGHT <date when="1908"
                        >1908</date>, BY</l>
                  <l>FRIENDSHIP CALENDAR CO.</l>
                  <l>NEW BRITAIN, CONN.</l></emph></fw>
            <milestone unit="line" rend="dotted-line"/>
            <dateline hand="#printFancy"><emph rend="drop cap"><add hand="#redPen"
                     rend="Mary Behrend colored the letter 'F' in red">F</add></emph>ebruary
               16,1909.</dateline>
            <dateline>Tuesday</dateline>
            <figure place="center" hand="#multiMedia">
               <figDesc> Drawing of Mr. Behrend catching a large black bug </figDesc>
            </figure>
            <ab hand="#blackPen" rend="cursive"><l>Mr. Behrend finds a</l><l>big bug!</l><l><emph
                     hand="#redPen">I wonder if you have found many lately!</emph></l></ab>
         </div>
         <div type="sheet" n="2">
            <fw place="top-center" hand="#print"><emph rend="bold"><l>COPYRIGHT <date when="1908"
                        >1908</date>, BY</l>
                  <l>FRIENDSHIP CALENDAR CO.</l>
                  <l>NEW BRITAIN, CONN.</l></emph></fw>
            <milestone unit="line" rend="dotted-line"/>
            <dateline hand="#printFancy"><emph rend="drop cap"><add hand="#greenPen"
                     rend="Mary Behrend colored the letter 'M' in green">M</add></emph>arch
               17,1909.</dateline>
            <dateline>Wednesday</dateline>
            <dateline>St. Patrick's Day</dateline>
            <figure place="below dateline" hand="#multiMedia">
               <figDesc>Two green shamrocks on opposite edges of the sheet with two black ink snake
                  doodles between them towards the center of the page</figDesc>
            </figure>
            <ab hand="#blackPen" rend="printed writing"><l>ST. PATRICK WAS A USEFUL SAINT</l><l>HE
                  FRIGHTENED ALL THE SNAKES AWAY-</l><l>I WISH HE'D TRY HIS ART ON <emph
                     rend="underlined">SMOKE</emph></l><l>AROUND THE HAMMERMILL SOME DAY!</l></ab>
            <figure place="bottom" hand="#multiMedia">
               <figDesc>Green shamrok with a drawing in black ink of the Hammermil building to the
                  right of it</figDesc>
            </figure>
            <ab hand="#redPen" rend="cursive"><l>The Hammermill really <emph rend="underlined"><gap reason="illegible"/> <!-- attempting to mark my uncertainty with the reading of this sentence, the letters in the words are quite hard to make out -->
                  <unclear reason="illegible">lucky!</unclear></emph></l></ab>
         </div>
      </body>
   </text>
</TEI>
